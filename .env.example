# NHL Value Tracker — Environment Variables
# Copy this file to .env and fill in values

# Port for the Express server (default: 3001)
PORT=3001

# Secret key to protect the POST /api/refresh endpoint
# Set to any random string, e.g. openssl rand -hex 32
REFRESH_SECRET=change-me-to-a-random-secret

# Optional: CORS origin whitelist (comma-separated)
# Leave blank to allow all origins (fine for development)
# CORS_ORIGIN=https://your-frontend.vercel.app
